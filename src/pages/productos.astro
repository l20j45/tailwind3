---
import Layout from "../layouts/Layout.astro";
import BootsList from "../components/Boots/BootsList.svelte";
---

<Layout>

    <section>
    <div class="relative pt-56  md:pt-20">
      <div class="relative z-10 container px-4 mx-auto">
        <div class="flex flex-wrap items-center -m-8">
          <div class="relative z-10 w-full md:w-1/2  p-8">
            <div class="md:max-w-xl">
              <span
                class="inline-block mb-2.5 text-sm text-green-400 font-medium tracking-tighter"
                >Calzado Industrial de Calidad</span
              >
              <h1
                class="font-heading mb-8 text-7xl lg:text-8xl xl:text-10xl text-black tracking-tighter"
              >
                Calzado de seguridad fabricado en México con estándares
                internacionales.
              </h1>
              <p class="mb-10 text-lg text-black md:max-w-md">
                Todos nuestros modelos cuentan con garantía de 60 días y
                certificación NOM-113-STPS-2009.
              </p>
              <div class="flex flex-wrap gap-4">
                
                <a
                  class="inline-block px-8 py-4 text-black hover:text-black tracking-tighter hover:bg-green-400 border-2 border-white focus:border-green-400 focus:border-opacity-40 hover:border-green-400 focus:ring-4 focus:ring-green-400 focus:ring-opacity-40 rounded-full transition duration-300"
                  href="contacto">Contactar</a
                >
              </div>
            </div>
          </div>
          <div class=" md:w-1/2 lg:w-5/12 p-8">
            <div class="relative max-w-max mx-auto md:mr-0">
              <img
                class="rounded-3xl"
                src="/images/sr_boots_portada_catalogo.png"
                alt="Botas industriales SR Boots GDL"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
    <img
      class="absolute top-0 left-0"
      src="/nightsable-assets/images/headers/layer-blur.svg"
      alt=""
    />
  </section>
    <div class="">
      <div class="min-h-screen py-12 px-4">
        <div class="flex flex-col max-w-7xl mx-auto">

            <BootsList client:only />

          <div
            class="mt-20 max-w-2xl mx-auto text-center border border-gray-900 rounded-3xl p-12"
          >
            <h4 class="mb-4 text-4xl text-black tracking-tighter">
              Recibe nuestras ofertas
            </h4>
            <p class="mb-8 text-black text-opacity-60">
              Suscríbete a nuestro boletín y recibe descuentos exclusivos en
              calzado de seguridad.
            </p>
            <div
              class="relative max-w-md mx-auto border border-gray-900 focus-within:border-white overflow-hidden rounded-3xl"
            >
              <input
                class="custom-input-text-4 relative z-10 px-8 pr-28 pt-8 pb-3 text-gray-300 w-full placeholder-gray-300 outline-none bg-transparent"
                type="text"
                required=""
              />
              <label
                class="absolute left-8 top-1/2 transform -translate-y-1/2 text-gray-300 transition duration-300"
                >Tu correo electrónico</label
              >
              <a
                class="absolute z-20 right-0 top-0 flex items-center justify-center px-8 h-full bg-green-400 hover:bg-green-500 rounded-3xl transition duration-300"
                href="#"
              >
                <svg
                  width="10"
                  height="17"
                  viewBox="0 0 10 17"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M1.79687 15.4299L7.50188 9.72495C8.17563 9.0512 8.17563 7.9487 7.50188 7.27495L1.79688 1.56995"
                    stroke="black"
                    stroke-width="2"
                    stroke-miterlimit="10"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
</Layout>
